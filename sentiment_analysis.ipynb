"""
# Task 2: Sentiment and Thematic Analysis

## Setup and Imports
"""

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scripts.sentiment_theme_analysis import SentimentThemePipeline

# Load results
df = pd.read_csv('data/sentiment_theme_results.csv')
print(f"Loaded {len(df)} reviews")

"""
## Sentiment Distribution Visualization
"""

# Create figure
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Overall sentiment
sentiment_counts = df['sentiment_label'].value_counts()
axes[0].bar(sentiment_counts.index, sentiment_counts.values, color=['green', 'red', 'gray'])
axes[0].set_title('Overall Sentiment Distribution')
axes[0].set_ylabel('Count')

# Sentiment by bank
bank_sentiment = pd.crosstab(df['bank'], df['sentiment_label'], normalize='index')
bank_sentiment.plot(kind='bar', ax=axes[1], color=['green', 'red', 'gray'])
axes[1].set_title('Sentiment by Bank')
axes[1].set_ylabel('Proportion')
plt.tight_layout()
plt.savefig('data/sentiment_visualization.png')
plt.show()

"""
## Theme Distribution
"""

theme_dist = df['identified_theme'].value_counts()
print("\nTheme Distribution:")
print(theme_dist)

# Theme by bank
bank_theme = pd.crosstab(df['bank'], df['identified_theme'], normalize='index')
print("\nThemes by Bank:")
print(bank_theme)

"""
## Sentiment vs Rating Analysis
"""

rating_sentiment = df.groupby('rating').agg({
    'sentiment_score': 'mean',
    'sentiment_label': lambda x: (x == 'positive').mean()
}).round(3)

print("\nSentiment by Rating:")
print(rating_sentiment)